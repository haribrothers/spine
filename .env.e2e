# Loaded by apps/e2e's Playwright config (via `webServer`) to boot real
# apps/api and apps/web instances for the E2E suite, pointed at a dedicated
# scratch database — same reasoning as .env.test (see that file's own
# comment): integration/E2E tests TRUNCATE real tables, so they must never
# share a database with local dev.
#
# `spine_e2e` must exist on the same Postgres server DATABASE_URL in `.env`
# points at, with the schema applied (`createdb spine_e2e` then
# `DATABASE_URL=postgres://spine:spine@localhost:5432/spine_e2e pnpm
# --filter @spine/api db:migrate`). CI creates and migrates its own
# ephemeral database instead (see .github/workflows/ci.yml) — this file is
# for running the E2E suite locally against docker-compose.dev.yml's infra.
DATABASE_URL=postgres://spine:spine@localhost:5432/spine_e2e
AUTH_SECRET=e2e-test-secret-not-for-production-use-only
APP_URL=http://localhost:3100
API_URL=http://localhost:4100
NEXT_PUBLIC_API_URL=http://localhost:4100
PORT=4100
MAILDEV_URL=http://localhost:1080

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=quotes@spine.local

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=spine
S3_ACCESS_KEY=spine
S3_SECRET_KEY=spinespine

CURRENCY=USD
LOCALE=en-US
TZ=UTC
SEED_DEMO=false
