{
  "name": "spine",
  "private": true,
  "version": "1.0.0-beta.2",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=!@spine/mobile --filter=!@spine/showcase-native",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "dev:mobile": "pnpm --filter @spine/mobile start",
    "dev:ios": "pnpm --filter @spine/mobile ios",
    "dev:android": "pnpm --filter @spine/mobile android",
    "dev:showcase-native": "pnpm --filter @spine/showcase-native start",
    "dev:showcase-native:ios": "pnpm --filter @spine/showcase-native ios",
    "dev:showcase-native:android": "pnpm --filter @spine/showcase-native android",
    "create:native-app": "node scripts/create-native-app.mjs",
    "dev:infra:up": "docker compose -f docker-compose.dev.yml up -d",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "dev:infra:reset": "docker compose -f docker-compose.dev.yml down -v && pnpm dev:infra:up",
    "dev:infra:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "db:migrate:dev": "pnpm --filter @spine/api db:migrate",
    "db:seed:dev": "pnpm --filter @spine/api db:seed",
    "db:reset:dev": "pnpm --filter @spine/api db:reset",
    "test:e2e": "pnpm --filter @spine/e2e test",
    "test:e2e:ui": "pnpm --filter @spine/e2e test:ui",
    "verify": "node scripts/verify.mjs",
    "site:build": "node scripts/site/build-pages.mjs",
    "test:scripts": "node --test \"scripts/**/*.test.mjs\""
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "body-parser@>=2.0.0 <2.4.0": "^2.4.0",
      "brace-expansion@<1.1.20": "^1.1.20",
      "brace-expansion@>=2.0.0 <2.1.6": "^2.1.6",
      "brace-expansion@>=4.0.0 <5.0.11": "^5.0.11",
      "compression@<1.8.2": "^1.8.2",
      "fast-uri@>=3.0.0 <3.1.7": "^3.1.7",
      "form-data@>=4.0.0 <4.0.6": "^4.0.6",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "multer@<2.5.0": "^2.5.0",
      "nanoid@>=3.0.0 <3.3.18": "^3.3.18",
      "node-forge@<1.4.3": "^1.4.3",
      "postcss@>=8.0.0 <8.5.18": "^8.5.18",
      "proxy-addr@<2.0.8": "^2.0.8",
      "shell-quote@>=1.8.4 <1.11.0": "^1.11.0",
      "source-map-js@>=1.0.0 <1.2.2": "^1.2.2",
      "undici@>=8.0.0 <8.12.2": "^8.12.2",
      "vitest>vite": "^6.4.4"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-5gmw-xhrv-c9v3",
        "GHSA-5p2g-fcmc-qvqq",
        "GHSA-85c8-ppgw-ccpr",
        "GHSA-mrhx-c7xc-m3w5",
        "GHSA-qr28-fpjm-wq7f",
        "GHSA-w3rx-r6r6-pgpr"
      ]
    }
  }
}
