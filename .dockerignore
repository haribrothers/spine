# Keep secrets, local data and host build output out of the images.
# Dependencies are installed and everything is built inside the image.
.git
.env
.env.*
!.env.example
**/.data
**/node_modules
**/.next
**/.next-*
**/.turbo
**/dist
**/.expo
**/coverage
apps/e2e/test-results
apps/e2e/playwright-report
*.log
.DS_Store
# Not part of the API or web images: the native apps (with their Android and
# iOS builds), the component showcases, and the development docs checked out
# locally under docs/.
apps/mobile
apps/showcase-native
apps/design-system
docs

# Backups hold the whole database (US-OPS-03).
backups
