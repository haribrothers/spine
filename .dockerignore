# Keep secrets, local data and host build output out of the images.
# Dependencies are installed and everything is built inside the image.
.git
.claude
.env
.env.*
!.env.example
**/.data
**/node_modules
**/.next
**/.turbo
**/dist
**/.expo
**/coverage
apps/e2e/test-results
apps/e2e/playwright-report
*.log
.DS_Store
