{
  "name": "@spine/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "dotenv -e ../../.env -- next build",
    "build:e2e": "dotenv -e ../../.env.e2e -v NEXT_DIST_DIR=.next-e2e -- next build",
    "dev": "dotenv -e ../../.env -- next dev --port 3000",
    "start": "dotenv -e ../../.env -- next start",
    "start:e2e": "dotenv -e ../../.env.e2e -v NEXT_DIST_DIR=.next-e2e -- next start --port 3110",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@spine/shared": "workspace:*",
    "@spine/ui": "workspace:*",
    "better-auth": "^1.6.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.469.0",
    "next": "^15.1.0",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^5.2.0",
    "recharts": "^3.10.0"
  },
  "devDependencies": {
    "@spine/config": "workspace:*",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv-cli": "^7.4.0",
    "eslint": "^9.17.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
