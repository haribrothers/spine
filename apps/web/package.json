{
  "name": "@spine/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "dotenv -e ../../.env -- next build",
    "build:e2e": "dotenv -e ../../.env.e2e -v NEXT_DIST_DIR=.next-e2e -- next build",
    "dev": "dotenv -e ../../.env -- next dev --port 3000",
    "start": "dotenv -e ../../.env -- next start",
    "start:e2e": "dotenv -e ../../.env.e2e -v NEXT_DIST_DIR=.next-e2e -- next start --port 3110",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "1.7.11",
    "@spine/shared": "workspace:*",
    "@spine/ui": "workspace:*",
    "better-auth": "^1.7.11",
    "date-fns": "^4.1.0",
    "i18next": "26.5.3",
    "lucide-react": "^0.469.0",
    "next": "^15.1.0",
    "next-themes": "^0.4.6",
    "papaparse": "^5.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-easy-crop": "^5.2.0",
    "react-i18next": "17.1.0",
    "recharts": "^3.10.0"
  },
  "devDependencies": {
    "@spine/config": "workspace:*",
    "@tailwindcss/postcss": "^4.0.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.10.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4",
    "dotenv-cli": "^7.4.0",
    "eslint": "^9.17.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
