---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

/**
 * US-SITE-06 — a screen captured from a demo install (`pnpm --filter
 * @spine/e2e screenshots`), in the reader's theme. `id` names the files
 * `src/assets/screens/<id>-light.webp` and `<id>-dark.webp`, listed in
 * `screenshots/*.json`. Until it's been captured, the page shows the
 * description instead.
 */
interface Props {
  id: string;
  alt: string;
}
const { id, alt } = Astro.props;
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/screens/*.webp", { eager: true });
const light = images[`../assets/screens/${id}-light.webp`]?.default;
const dark = images[`../assets/screens/${id}-dark.webp`]?.default;
---

<figure class="spine-screenshot">
  {
    light && dark ? (
      <>
        <Image class="spine-screenshot__light" src={light} alt={alt} widths={[720, 1440]} sizes="(min-width: 50rem) 48rem, 100vw" />
        <Image class="spine-screenshot__dark" src={dark} alt={alt} widths={[720, 1440]} sizes="(min-width: 50rem) 48rem, 100vw" />
      </>
    ) : (
      <div class="spine-screenshot__placeholder">Screenshot: {alt}</div>
    )
  }
  <figcaption>{alt}</figcaption>
</figure>
