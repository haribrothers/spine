{
  "name": "@spine/api",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "nest build",
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests --exclude '**/*.integration.test.ts'",
    "test:integration": "dotenv -e ../../.env.test -e ../../.env -- vitest run --config vitest.integration.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e ../../.env -- drizzle-kit migrate",
    "db:migrate:e2e": "dotenv -e ../../.env.e2e -- drizzle-kit migrate",
    "start:e2e": "dotenv -e ../../.env.e2e -- node dist/main.js",
    "db:studio": "dotenv -e ../../.env -- drizzle-kit studio",
    "db:seed": "dotenv -e ../../.env -- tsx src/db/seed/index.ts",
    "db:reset": "dotenv -e ../../.env -- tsx src/db/reset.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.4.0",
    "@node-rs/argon2": "^2.0.0",
    "@react-pdf/renderer": "^4.5.1",
    "@spine/shared": "workspace:*",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "better-auth": "^1.6.0",
    "drizzle-orm": "^0.45.0",
    "express": "^5.1.0",
    "jose": "^6.2.8",
    "node-html-parser": "^9.0.1",
    "nodemailer": "^9.0.5",
    "pg-boss": "^12.27.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.1.0",
    "@spine/config": "workspace:*",
    "@swc/core": "^1.15.47",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "@types/web-push": "^3.6.4",
    "dotenv-cli": "^7.4.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "unplugin-swc": "^1.5.10",
    "vitest": "^2.1.0"
  }
}
