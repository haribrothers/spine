# Local dev env for the field app. Metro reads EXPO_PUBLIC_* from an .env
# file at this app's root.
#
#   cp .env.development.example .env
#
# People type their server address on Sign in (US-MOB-01); in development
# this only pre-fills that field. Use the API's own address (apps/api's
# `pnpm dev`, port 4000) as the device sees it:
#
#   - iOS Simulator: http://localhost:4000 (it shares the Mac's network).
#   - Android emulator: http://10.0.2.2:4000 (the emulator's alias for the host).
#   - A real phone on the same Wi-Fi: http://<your LAN IP>:4000
#     (`ipconfig getifaddr en0` on macOS).
EXPO_PUBLIC_DEFAULT_SERVER=http://localhost:4000
