{
  "expo": {
    "name": "Spine",
    "slug": "spine-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "spine",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spine.app"
    },
    "android": {
      "package": "com.spine.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "storeLinks": {
        "ios": "https://apps.apple.com/app/spine",
        "android": "https://play.google.com/store/apps/details?id=com.spine.app"
      }
    }
  }
}
