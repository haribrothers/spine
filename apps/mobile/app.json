{
  "expo": {
    "name": "Spine",
    "slug": "spine-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "spine",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spine.app",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/ios-icon-dark.png",
        "tinted": "./assets/ios-icon-tinted.png"
      }
    },
    "android": {
      "package": "com.spine.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Spine uses the camera for site photos and receipts. They're saved to your jobs and expenses, and nowhere else.",
          "photosPermission": "Spine opens your photos when you choose a receipt or site photo you've already taken. Only the photo you pick is used.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Spine uses the camera for site photos and receipts. They're saved to your jobs and expenses, and nowhere else.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "backgroundColor": "#F7F6F3",
          "dark": {
            "image": "./assets/splash-mark.png",
            "backgroundColor": "#121110"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "extra": {
      "storeLinks": {
        "ios": "https://apps.apple.com/app/spine",
        "android": "https://play.google.com/store/apps/details?id=com.spine.app"
      }
    }
  }
}
