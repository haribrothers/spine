# Required — the app will not boot without these three.
DATABASE_URL=postgres://spine:spine@db:5432/spine
AUTH_SECRET=change-me-to-a-random-32-byte-string
APP_URL=http://localhost

# Where the API itself is reachable. Caddy reverse-proxies api/web under one
# origin in this stack, so this is the same as APP_URL — both browser and
# server-side requests from web reach the API through that single origin.
API_URL=http://localhost
NEXT_PUBLIC_API_URL=http://localhost

# Postgres (used by the db service; keep in sync with DATABASE_URL above)
POSTGRES_PASSWORD=spine

# Optional — SMTP. If unset, documents still issue and email queues for retry.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional — S3-compatible file storage. If unset, MinIO defaults below apply
# under the `full` compose profile; if MinIO isn't running either, the app
# runs read-only for attachments rather than failing globally.
S3_ENDPOINT=
S3_BUCKET=spine
S3_ACCESS_KEY=spine
S3_SECRET_KEY=spinespine

# Optional — locale/currency/timezone defaults
CURRENCY=USD
LOCALE=en-US
TZ=UTC

# Optional — remote access via Cloudflare Tunnel (full profile only)
CLOUDFLARE_TUNNEL_TOKEN=

# Optional — seed a demo dataset on first boot
SEED_DEMO=false

# Optional — browser push notifications (S-10.12). If unset, the push
# channel is silently disabled (in-app panel + email still work). Generate
# a keypair with `npx web-push generate-vapid-keys`. The public key is
# served to the browser via GET /notifications/push/public-key — no
# separate NEXT_PUBLIC_ copy needed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost
