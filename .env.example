# Required — the app will not boot without these three.
DATABASE_URL=postgres://spine:spine@db:5432/spine
AUTH_SECRET=change-me-to-a-random-32-byte-string
APP_URL=http://localhost

# Where the API itself is reachable. Caddy reverse-proxies api/web under one
# origin in this stack, so this is the same as APP_URL — both browser and
# server-side requests from web reach the API through that single origin.
API_URL=http://localhost
NEXT_PUBLIC_API_URL=http://localhost

# Postgres (used by the db service; keep in sync with DATABASE_URL above)
POSTGRES_PASSWORD=spine

# Optional — SMTP. If unset, documents still issue and email queues for retry.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# File storage (D-102). `local` (the default) keeps files on the API
# container's `spine_files` volume at /data/files — no extra service needed.
# Set `s3` to use AWS S3, Cloudflare R2, Backblaze B2 or a self-hosted store
# (the `rustfs` compose profile, endpoint http://rustfs:9000), then fill in
# the S3_* values. Files stored before a switch stay readable while the
# old driver's settings are still present.
STORAGE_DRIVER=local
# FILES_DIR=/data/files
# S3_ENDPOINT=
# S3_BUCKET=spine
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# Optional — locale/currency/timezone defaults
CURRENCY=USD
LOCALE=en-US
TZ=UTC

# Optional — remote access via Cloudflare Tunnel (full profile only)
CLOUDFLARE_TUNNEL_TOKEN=

# Optional — logs (US-OPS-07). JSON lines in production (the API image sets
# NODE_ENV=production), readable lines otherwise; LOG_FORMAT overrides it.
# Every request is logged with its id unless LOG_REQUESTS=off. Passwords,
# tokens, cookies and full card or bank numbers are never written.
# LOG_FORMAT=json
# LOG_REQUESTS=on

# Optional — seed a demo dataset on first boot
SEED_DEMO=false

# Optional — browser push notifications (S-10.12). If unset, the push
# channel is silently disabled (in-app panel + email still work). Generate
# a keypair with `npx web-push generate-vapid-keys`. The public key is
# served to the browser via GET /notifications/push/public-key — no
# separate NEXT_PUBLIC_ copy needed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# Optional — the oldest field app this server accepts (D-071, US-MOB-10).
# An older app gets 426 and shows "Update Spine to keep going"; unset
# accepts every version. Example: MOBILE_MIN_VERSION=1.2.0
MOBILE_MIN_VERSION=
