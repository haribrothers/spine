# Local development env — apps/api and apps/web run natively via `pnpm dev`
# and talk to the dev infra containers (docker-compose.dev.yml) over
# localhost, not the Docker network hostnames used in .env.example.
#
# Copy to .env and adjust if you changed ports in docker-compose.dev.yml:
#   cp .env.development.example .env

DATABASE_URL=postgres://spine:spine@localhost:5432/spine
AUTH_SECRET=dev-only-secret-change-for-anything-real
APP_URL=http://localhost:3000

# Where the API itself is reachable — used as Better Auth's baseURL (server)
# and by apps/web to build absolute fetch URLs to the API (browser + server
# components both hit this directly in dev, since api/web run on separate
# ports; in prod they're reverse-proxied under one origin via Caddy).
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Optional — matches docker-compose.dev.yml's minio service.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=spine
S3_ACCESS_KEY=spine
S3_SECRET_KEY=spinespine

# Optional — left blank by default; SMTP degrades gracefully when unset
# (documents still issue, email queues for retry). To see quote emails
# locally instead of only inferring success from pg-boss job state, set
# SMTP_HOST=localhost to point at docker-compose.dev.yml's maildev service
# and read what "sent" at http://localhost:1080 (nothing is ever actually
# delivered) — the port/from below already match maildev's defaults.
SMTP_HOST=
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=quotes@spine.local

CURRENCY=USD
LOCALE=en-US
TZ=UTC

SEED_DEMO=false

# Optional — browser push notifications (S-10.12). Left blank by default;
# the push channel silently disables itself when unset (in-app panel +
# email still work). Generate a keypair with `npx web-push generate-vapid-keys`
# and paste both values below to test it locally.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost
