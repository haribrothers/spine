FROM node:22-alpine AS base
# better-auth/drizzle-orm declare better-sqlite3 as a peer dep (one of
# several drivers Drizzle supports) even though this app only ever uses
# the Postgres driver — pnpm still attempts to build its native addon
# during install, which needs a C toolchain + Python that bare
# node:22-alpine doesn't ship.
RUN apk add --no-cache python3 make g++
RUN corepack enable

FROM base AS deps
WORKDIR /repo
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/api/package.json apps/api/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/config/package.json packages/config/package.json
# `canvas` is a test-only dependency (jsdom in packages/ui's tests) that
# still lands here through peer dependencies; nothing in production loads
# it, and it can't compile on Alpine without cairo/pango, so skip its build
# (only in this image — dev machines still build it for the UI tests).
RUN node -e 'const f="package.json",p=JSON.parse(require("fs").readFileSync(f));p.pnpm.neverBuiltDependencies=["canvas"];require("fs").writeFileSync(f,JSON.stringify(p,null,2))'
RUN pnpm install --frozen-lockfile --filter @spine/api...

FROM base AS build
WORKDIR /repo
COPY --from=deps /repo /repo
COPY . .
# @spine/api's own "build" script is a plain `nest build` — it doesn't
# know how to build its workspace dependencies, so @spine/shared (compiled
# to dist/, not run from .ts source in production — see its package.json)
# must build first, explicitly, rather than relying on --filter's
# dependency selection to also trigger it.
RUN pnpm --filter @spine/shared build
RUN pnpm --filter @spine/api build

# US-OPS-01: production dependencies only, installed fresh, so the image
# carries no build tools, dev dependencies or source.
FROM base AS prod-deps
WORKDIR /repo
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml* ./
COPY apps/api/package.json apps/api/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/config/package.json packages/config/package.json
RUN node -e 'const f="package.json",p=JSON.parse(require("fs").readFileSync(f));p.pnpm.neverBuiltDependencies=["canvas"];require("fs").writeFileSync(f,JSON.stringify(p,null,2))'
RUN pnpm install --frozen-lockfile --prod --filter @spine/api...
# Peer dependencies of Better Auth and Drizzle that the API never loads (Next.js,
# React Native, Expo, sharp), TypeScript (tests only) and canvas builds for
# glibc (this image is Alpine): about a gigabyte nobody downloads.
RUN cd node_modules/.pnpm && rm -rf next@* @next+swc-* react-native@* @react-native+* expo@* expo-* hermes-* typescript@* @napi-rs+canvas-*-gnu@* @img+sharp-*

FROM node:22-alpine AS runtime
WORKDIR /repo
ENV NODE_ENV=production
COPY --from=prod-deps /repo /repo
COPY --from=build /repo/packages/shared/dist packages/shared/dist
COPY --from=build /repo/apps/api/dist apps/api/dist
# The migrations the API applies when it starts (D-264): the SQL and the journal, not drizzle-kit's snapshots.
COPY apps/api/drizzle/*.sql apps/api/drizzle/
COPY apps/api/drizzle/meta/_journal.json apps/api/drizzle/meta/
# The local storage driver writes to the spine_files volume mounted here
# (D-102). A fresh named volume takes this folder's owner, so the API runs
# as the image's non-root `node` user and still owns its files.
RUN mkdir -p /data/files && chown node:node /data/files
USER node
EXPOSE 4000
CMD ["node", "apps/api/dist/main.js"]
